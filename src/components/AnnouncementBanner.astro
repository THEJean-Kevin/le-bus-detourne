---
// src/components/AnnouncementBanner.astro
import { announcements } from "../data/Announcements.ts";
---

<div class="announcement-stack" hidden>
  <p class="announcement-title">Point Actualité</p>

  {announcements.map((a) => (
    <div
      class="announcement-banner"
      data-start-date={a.startDate ?? ""}
      data-end-date={a.endDate ?? ""}
      hidden
    >
      <p class="announcement-text">
        {a.text}
        {a.website && (
          <a
            href={a.website}
            class="announcement-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            En savoir plus
          </a>
        )}
      </p>
    </div>
  ))}
</div>

<script>
  function updateAnnouncements() {
    const today = new Date();

    // Date locale au format YYYY-MM-DD
    const currentDate = [
      today.getFullYear(),
      String(today.getMonth() + 1).padStart(2, "0"),
      String(today.getDate()).padStart(2, "0"),
    ].join("-");

    document.querySelectorAll(".announcement-stack").forEach((stack) => {
      const banners = stack.querySelectorAll(".announcement-banner");

      let hasActiveAnnouncement = false;

      banners.forEach((banner) => {
        const startDate = banner.getAttribute("data-start-date");
        const endDate = banner.getAttribute("data-end-date");

        const isActive =
          (!startDate || currentDate >= startDate) &&
          (!endDate || currentDate <= endDate);

        (banner as HTMLElement).hidden = !isActive;

        if (isActive) {
          hasActiveAnnouncement = true;
        }
      });

      (stack as HTMLElement).hidden = !hasActiveAnnouncement;
    });
  }

  // Vérification au chargement
  updateAnnouncements();


  // Vérification lorsque l'utilisateur revient sur l'onglet
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) {
      updateAnnouncements();
    }
  });
</script>

<style>
  .announcement-title {
    font-size: 1.2rem;
    font-weight: bold;
    margin-bottom: 0rem;
    width: 100%;
    background-color: #f4ab4b;
    color: #0d4042;
    padding-top: 0.6rem;
    text-align: center;
    text-decoration: underline;
    white-space: nowrap;
  }
  .announcement-stack {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .announcement-banner {
    width: 100%;
    background-color: #f4ab4b;
    color: #0d4042;
    padding: 0.6rem 1rem;
    text-align: center;
    border-bottom: 0.1rem solid rgba(0, 0, 0, 0.14);
    [hidden] {
      display: none !important;
    }
  }

  .announcement-text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.4;
    max-width: 900px;
    margin-inline: auto;
    /* passe à la ligne naturellement si le texte est trop long */
    white-space: normal;
    word-break: break-word;
  }

  .announcement-link {
    display: inline-block;
    margin-left: 0.6rem;
    color: #0d4042;
    font-weight: 600;
    text-decoration: underline;
    white-space: nowrap;
  }

  .announcement-link:hover {
    color: #019899;
  }

  @media (max-width: 480px) {
    .announcement-text {
      font-size: 0.85rem;
    }
  }
</style>