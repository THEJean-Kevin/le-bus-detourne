---
// Footer.astro — utilisé par BaseLayout.astro sur toutes les pages.
import { navLinks } from '../data/nav.js';
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-logo">Le Bus Dé'tourné</p>
      <p>Bar à jeux nomade en Loire-Atlantique.</p>
    </div>
    <div>
      <h4>Navigation</h4>
      <ul class="footer-links">
        {navLinks.map((link) => (
          <li><a href={base + link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h4>Contact</h4>
      <p><a href="mailto:lebusdetourne@hotmail.com">lebusdetourne@hotmail.com</a><br />06 61 56 97 21</p>
      <p><a href="https://www.instagram.com/le_bus_detourne/" target="_blank" rel="noopener noreferrer">Instagram</a> · <a href="https://www.facebook.com/LeBusDetourne" target="_blank" rel="noopener noreferrer">Facebook</a></p>
    </div>
  </div>
  <p class="footer-bottom">© {new Date().getFullYear()} Le Bus Dé'tourné</p>
</footer>

<style>
  .site-footer {
    background: var(--color-teal-dark);
    color: #f3ece0;
    font-size: 0.9rem;
  }
  .footer-grid {
    padding-block: 2.4rem 1.4rem;
    display: grid;
    gap: 1.6rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .footer-grid { grid-template-columns: 1.3fr 1fr 1fr; }
  }
  .footer-logo { font-family: var(--font-title); font-size: 1.5rem; margin: 0 0 0.4rem; }
  .site-footer h4 {
    font-family: var(--font-body);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-amber);
    margin: 0 0 0.6rem;
  }
  .footer-links { list-style: none; padding: 0; margin: 0; }
  .footer-links a { text-decoration: none; opacity: 0.9; }
  .footer-bottom {
    text-align: center;
    font-size: 0.75rem;
    opacity: 0.7;
    padding: 1rem 0 1.4rem;
    margin: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
</style>
