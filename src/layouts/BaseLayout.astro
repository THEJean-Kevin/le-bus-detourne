---
// BaseLayout.astro — enveloppe commune à toutes les pages.
// Chaque page : import BaseLayout puis <BaseLayout title="..." description="...">.
import Header from '../components/Header.astro';
import AnnouncementBanner from "../components/AnnouncementBanner.astro";
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '@fontsource-variable/quicksand';
import logo from '../assets/images/logo.png'
import ogDefault from '../assets/images/og-default.jpg'
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface Props {
  title: string;
  description?: string;
  image?: string;
}
const { title, description = "Bar à jeux nomade en Loire-Atlantique.", image = ogDefault.src } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Le Bus Dé'tourné</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href={`${base}/favicon.svg`} />


    <!-- Open Graph / partage réseaux sociaux -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Le Bus Dé'tourné`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL.toString()} />
    <meta property="og:locale" content="fr_FR" />


    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Le Bus Dé'tourné`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.toString()} />

    
    
    {import.meta.env.PUBLIC_NOINDEX && <meta name="robots" content="noindex, nofollow" />}

    <!-- Données structurées LocalBusiness (sert pour toutes les pages, Google privilégie la home) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FoodEstablishment",
      "name": "Le Bus Dé'tourné",
      "description": "Bar-restaurant à jeux nomade en Loire-Atlantique",
      "url": Astro.site?.toString(),
      "logo": new URL(logo.src, Astro.site).toString(),
      "image": new URL(ogDefault.src, Astro.site).toString(),
      "servesCuisine": "Street food",
      "priceRange": "€€",
      "areaServed": "Loire-Atlantique",
      "currenciesAccepted": "EUR",
      "paymentAccepted": "Cash, Credit Card",
      "hasMenu": new URL(base + "/menus", Astro.site).toString(),
      "telephone": "+33661569721",
      "sameAs": [
        "https://www.instagram.com/le_bus_detourne/",
        "https://www.facebook.com/LeBusDetourne"
      ]
    })} />

  </head>
  <body>
    <Header />
    <AnnouncementBanner />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
