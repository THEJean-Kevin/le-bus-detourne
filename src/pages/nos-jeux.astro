---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { resolveImage } from '../utils/images';
import { jeuxTypes, myludoUrl } from '../data/jeux.ts';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Nos jeux" description="Plus de 200 jeux à bord du Bus Dé'tourné.">
  <section class="section container">
    <p class="section-label">Ludothèque</p>
    <h2>Plus de 200 jeux à bord</h2>
    <p>
      Jeux d'ambiance, de stratégie, familiaux ou pour enfants : de quoi s'occuper toutes la journée, quel que soit l'âge ou le nombre de joueurs.
    </p>
    <div class="btn-row">
      <a class="btn btn-primary" href={myludoUrl} target="_blank" rel="noopener">
        🔎 Chercher un jeu sur MyLudo ↗
      </a>
    </div>

  </section>

  <section class="section container">
    <h2>Des jeux pour toutes les tables</h2>
    <p>
      Petits, grands, joueurs occasionnels ou passionnés : il y a toujours un jeu qui convient.
    </p>
    <div class="grid grid-3-up">
      {jeuxTypes.map((type,i) => (
        <article class="card">
          <div class="photo-placeholder">
            <Image
              src={resolveImage(type.photo)}
              alt={type.title}
              widths={[350, 700, 1000]}
              sizes="(max-width: 779px) calc(100vw - 78px), (max-width: 1240px) calc((100vw - 80px) / 3 - 38px), 350px"
              format="webp"
              quality={75}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              decoding="async"
            />
          </div>
          <h3>{type.title}</h3>
          <p>{type.desc}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>