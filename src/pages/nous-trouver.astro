---
import BaseLayout from '../layouts/BaseLayout.astro';
import { planning } from '../data/planning.js';
import Map from '../components/Map.astro';
const base = import.meta.env.BASE_URL;

const markers = planning.map((spot) => {
  const [lat, lng] = spot.geo.split(',').map(Number);
  return { lat, lng, label: spot.lieu, geo: spot.geo };
});


const jourISO = {
  'Lundi': 'Monday', 'Mardi': 'Tuesday', 'Mercredi': 'Wednesday',
  'Jeudi': 'Thursday', 'Vendredi': 'Friday', 'Samedi': 'Saturday', 'Dimanche': 'Sunday'
};

const events = planning.map((spot) => {
  const [lat, lng] = spot.geo.split(',').map(Number);
  const [heureDebut, heureFin] = spot.horaire.split(' - ').map(h => h.trim());

  return {
    "@type": "Event",
    "name": `Le Bus Dé'tourné à ${spot.lieu}`,
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "eventSchedule": {
      "@type": "Schedule",
      "byDay": `https://schema.org/${jourISO[spot.jour]}`,
      "startTime": heureDebut,
      "endTime": heureFin,
      "repeatFrequency": "P1W" // hebdomadaire
    },
    "location": {
      "@type": "Place",
      "name": spot.lieu,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": spot.adresse,
        "addressLocality": spot.lieu,
        "postalCode": spot.postal.split(' ')[0],
        "addressCountry": "FR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": lat,
        "longitude": lng
      }
    },
    "organizer": {
      "@type": "FoodEstablishment",
      "name": "Le Bus Dé'tourné"
    }
  };
});
---

<BaseLayout title="Nous trouver" description="Retrouvez Le Bus Dé'tourné chaque semaine à Couëron, Saint-Étienne-de-Montluc et Grandchamps-des-Fontaines.">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": events
  })} />
  <section class="section container">
    <p class="section-label">Planning</p>
    <h2>Notre tournée</h2>
    <p>
      Tous nos emplacements de la semaine, visibles d'un coup d'œil — pas besoin de cliquer
      pour trouver son jour.
    </p>

    <div class="week-strip">
      {planning.map((spot) => (
        <article class="day-tile">
          <span class="day-name">{spot.jour}</span>
          <div class="photo-placeholder">
            <img src={base + spot.photo} alt={spot.alt} />
          </div>
          <span class="lieu">{spot.lieu}</span>
          <a href={`https://www.google.com/maps?q=${spot.geo}`}
            data-geo={spot.geo}
            class="geo-link"
            target="_blank"
            rel="noopener noreferrer">
            <span class="adresse">{spot.adresse} <br/> {spot.postal}</span>
          </a>
          <span class="horaire">{spot.horaire}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="section container">
    <p class="section-label">Carte</p>
    <h2>Sur la carte</h2>
    <Map markers={markers} />
  </section>

  <section class="section container">
    <h2>Un événement à organiser ?</h2>
    <p>Le bus peut aussi venir pour une occasion privée ou professionnelle.</p>
    <a class="btn btn-primary" href={base + "/privatisations"}>Voir les privatisations</a>
  </section>
</BaseLayout>

<style>
  .week-strip {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    margin-block: 1.2rem 0.4rem;
  }
  @media (min-width: 560px) { .week-strip { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .week-strip { grid-template-columns: repeat(4, 1fr); } }

  .day-tile {
    background: var(--color-cream-card);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .day-name { font-weight: 700; font-size: 0.95rem; }
  .lieu { font-weight: 700; font-size: 0.9rem; line-height: 1.3; }
  .adresse { font-size: 0.82rem; opacity: 0.8; }
  .horaire { font-size: 0.85rem; color: var(--color-turquoise); font-weight: 700; }

  .map-placeholder { min-height: 220px; }
  @media (min-width: 780px) { .map-placeholder { min-height: 300px; } }
</style>

<script>
  const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
  if (isMobile) {
    document.querySelectorAll<HTMLAnchorElement>('a.geo-link[data-geo]').forEach((link) => {
      link.href = `geo:${link.dataset.geo}?q=${link.dataset.geo}`;
    });
  }
</script>