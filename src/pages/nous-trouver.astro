---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { resolveImage } from '../utils/images';
import { planning } from '../data/planning.ts';
import Map from '../components/Map.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const SITE = (Astro.site?.toString() ?? 'https://www.lebusdetourne.fr').replace(/\/$/, '');

const markers = planning.map((spot) => {
  const [lat, lng] = spot.geo.split(',').map(Number);
  return { lat, lng, label: spot.lieu, geo: spot.geo };
});


const jourISO: Record<string, string> = {
  'Lundi': 'Monday', 'Mardi': 'Tuesday', 'Mercredi': 'Wednesday',
  'Jeudi': 'Thursday', 'Vendredi': 'Friday', 'Samedi': 'Saturday', 'Dimanche': 'Sunday'
};

const slug = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '')
  .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');


  const heure = (t: string) => {
  const m = t.match(/(\d{1,2})\s*[h:]\s*(\d{2})?/i);
  if (!m) throw new Error(`Horaire illisible : "${t}" (attendu : 17h30 - 21h30)`);
  return `${m[1].padStart(2, '0')}:${m[2] ?? '00'}`;
};

const places = planning.map((spot) => {
  const [lat, lng] = spot.geo.split(',').map(Number);
  const [debut, fin] = spot.horaire.split(/\s*[-–—]\s*/).map(heure);
  return {
    "@type": "Place",
    "@id": `${SITE}/#lieu-${slug(`${spot.jour}-${spot.lieu}`)}`,
    "name": spot.lieu,
    "hasMap": `https://www.google.com/maps?q=${spot.geo}`,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": spot.adresse,
      "addressLocality": spot.lieu,
      "postalCode": spot.postal.split(' ')[0],
      "addressCountry": "FR"
    },
    "geo": { "@type": "GeoCoordinates", "latitude": lat, "longitude": lng },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": `https://schema.org/${jourISO[spot.jour]}`,
      "opens": debut,
      "closes": fin
    }
  };
});
---

<BaseLayout title="Nous trouver" description="Retrouvez Le Bus Dé'tourné chaque semaine à Couëron, Saint-Étienne-de-Montluc et Grandchamps-des-Fontaines.">
 <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": places
  })} />
  <section class="section container">
    <p class="section-label">Planning</p>
    <h2>Notre tournée</h2>
    <p>
      Tous nos emplacements de la semaine, visibles d'un coup d'œil
    </p>

    <div class="week-strip">
      {planning.map((spot, i) => (
        <article class="day-tile">
          <span class="day-name">{spot.jour}</span>
          <div class="photo-placeholder">
            <Image
              src={resolveImage(spot.photo)}
              alt={spot.alt}
              widths={[300, 600, 900]} width={600}
              sizes="(max-width: 559px) calc(100vw - 71px), (max-width: 999px) calc((100vw - 56px) / 2 - 31px), (max-width: 1240px) calc((100vw - 88px) / 4 - 31px), 257px"
              format="webp"
              quality={75}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              decoding="async"
            />
          </div>
          <span class="lieu">{spot.lieu}</span>
          <a href={`https://www.google.com/maps?q=${spot.geo}`}
            data-geo={spot.geo}
            class="geo-link"
            target="_blank"
            rel="noopener noreferrer">
            <span class="adresse">{spot.adresse} <br/> {spot.postal}</span>
          </a>
          <span class="horaire">{spot.horaire}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="section container">
    <p class="section-label">Carte</p>
    <h2>Sur la carte</h2>
    <Map markers={markers} />
  </section>

  <section class="section container">
    <h2>Un événement à organiser ?</h2>
    <p>Anniversaire, lendemain de mariage, séminaire, festival... Le Bus s'installe chez vous pour tous vos événements que cela soit particulier, professionnel ou manifestation publique !</p>
    <a class="btn btn-primary" href={base + "/privatisations"}>Voir les privatisations</a>
  </section>
</BaseLayout>

<style>
  .week-strip {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    margin-block: 1.2rem 0.4rem;
  }
  @media (min-width: 560px) { .week-strip { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .week-strip { grid-template-columns: repeat(4, 1fr); } }

  .day-tile {
    background: var(--color-cream-card);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .day-name { font-weight: 700; font-size: 0.95rem; }
  .lieu { font-weight: 700; font-size: 0.9rem; line-height: 1.3; }
  .adresse { font-size: 0.82rem; opacity: 0.8; }
  .horaire { font-size: 0.85rem; color: var(--color-turquoise); font-weight: 700; }

  .map-placeholder { min-height: 220px; }
  @media (min-width: 780px) { .map-placeholder { min-height: 300px; } }
</style>

<script>
  const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
  if (isMobile) {
    document.querySelectorAll<HTMLAnchorElement>('a.geo-link[data-geo]').forEach((link) => {
      link.href = `geo:${link.dataset.geo}?q=${link.dataset.geo}`;
    });
  }
</script>