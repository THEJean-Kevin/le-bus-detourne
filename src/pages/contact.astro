---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Contactez le Bus Dé'tourné.">
  <section class="section container">
    <p class="section-label">Contact</p>
    <h2>Une question, une demande ?</h2>

    <div
      id="form-message"
      class="form-message"
      role="alert"
      aria-live="polite"
      hidden
    ></div>

    <div class="contact-wrap">
      <form
        class="contact-form"
        action="/contact.php"
        method="POST"
        novalidate
      >
        <!--
          Honeypot anti-spam.
          Invisible pour un humain, mais les bots ont tendance à le remplir.
        -->
        <div class="hp-field" aria-hidden="true">
          <label for="website">Website</label>
          <input
            type="text"
            id="website"
            name="website"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <div>
          <label for="nom">Nom</label>
          <input
            type="text"
            id="nom"
            name="nom"
            placeholder="Votre nom"
            required
            maxlength="100"
            autocomplete="name"
          />
        </div>

        <div>
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="vous@exemple.fr"
            required
            maxlength="150"
            autocomplete="email"
          />
        </div>

        <div>
          <label for="telephone">Téléphone (optionnel)</label>
          <input
            type="tel"
            id="telephone"
            name="telephone"
            placeholder="06 12 34 56 78"
            maxlength="30"
            autocomplete="tel"
          />
        </div>

        <div>
          <label for="message">Message</label>
          <textarea
            id="message"
            name="message"
            placeholder="Votre message"
            required
            maxlength="5000"
          ></textarea>
        </div>

        <button type="submit" class="btn btn-primary">
          Envoyer le message
        </button>
      </form>

      <div class="info-box">
        <strong>Le Bus Dé'tourné</strong><br />
        📧 lebusdetourne@hotmail.com<br />
        📞 06 61 56 97 21<br />
        📍 Loire-Atlantique<br /><br />

        <strong>Réseaux</strong><br />
        <a href="https://www.instagram.com/le_bus_detourne/" target="_blank" rel="noopener noreferrer">Instagram</a> · <a href="https://www.facebook.com/LeBusDetourne" target="_blank" rel="noopener noreferrer">Facebook</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  /*
   * Gestion des messages d'erreur renvoyés par contact.php.
   *
   * Le site étant statique, Astro ne peut pas lire ?error=...
   * côté serveur. On le fait donc côté navigateur.
   */

  const params = new URLSearchParams(window.location.search);
  const error = params.get('error');

  const messageBox = document.getElementById('form-message');

  const errors: Record<string, string> = {
    missing:
      'Merci de remplir tous les champs obligatoires.',

    email:
      'L’adresse e-mail indiquée n’est pas valide.',

    length:
      'Un ou plusieurs champs sont trop longs.',

    message:
      'Votre message est trop long. Merci de le raccourcir.',

    spam:
      'Votre demande n’a pas pu être traitée.',

    ratelimit:
      'Vous avez envoyé trop de messages récemment. Merci de patienter quelques minutes avant de réessayer.',

    server:
      'Une erreur est survenue lors de l’envoi du message. Merci de réessayer plus tard.'
  };

  if (error && messageBox && errors[error]) {
    messageBox.textContent = errors[error];
    messageBox.hidden = false;
    messageBox.classList.add('error');

    // Nettoyage de l'URL pour éviter de conserver ?error=...
    window.history.replaceState(
      {},
      document.title,
      window.location.pathname
    );
  }


  /*
   * Validation côté navigateur.
   *
   * La validation PHP reste obligatoire :
   * un bot peut complètement ignorer cette validation.
   */

  const form = document.querySelector<HTMLFormElement>('.contact-form');

  if (form) {
    form.addEventListener('submit', (event) => {
      const nom = document.querySelector<HTMLInputElement>('#nom');
      const email = document.querySelector<HTMLInputElement>('#email');
      const message = document.querySelector<HTMLTextAreaElement>('#message');

      if (!nom || !email || !message) {
        return;
      }

      if (!nom.value.trim() || !email.value.trim() || !message.value.trim()) {
        event.preventDefault();

        if (messageBox) {
          messageBox.textContent =
            'Merci de remplir tous les champs obligatoires.';
          messageBox.hidden = false;
          messageBox.classList.add('error');
        }

        return;
      }

      if (!email.validity.valid) {
        event.preventDefault();

        if (messageBox) {
          messageBox.textContent =
            'L’adresse e-mail indiquée n’est pas valide.';
          messageBox.hidden = false;
          messageBox.classList.add('error');
        }

        return;
      }
    });
  }
</script>

<style>
  .contact-wrap {
    display: grid;
    gap: 1.8rem;
    grid-template-columns: 1fr;
    margin-top: 1.2rem;
  }

  @media (min-width: 800px) {
    .contact-wrap {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 480px;
  }

  .contact-form label {
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 0.3rem;
    display: block;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    padding: 0.65rem 0.8rem;
    border: 1px solid #c9bf9f;
    border-radius: 8px;
    font-family: var(--font-body);
    font-size: 0.92rem;
    background: #fffdf9;
    box-sizing: border-box;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: 2px solid var(--color-line);
    outline-offset: 1px;
  }

  .contact-form textarea {
    min-height: 110px;
    resize: vertical;
  }

  /*
   * Champ honeypot.
   * On évite display:none afin que certains bots ne détectent
   * pas immédiatement qu'il s'agit d'un champ anti-spam.
   */
  .hp-field {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-message {
    max-width: 480px;
    margin-top: 1.2rem;
    margin-bottom: 1rem;
    padding: 0.85rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .form-message.error {
    background: #fff1ef;
    border: 1px solid #d9aaa2;
  }

  .info-box {
    background: var(--color-cream-card);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 1.2rem;
    font-size: 0.9rem;
    line-height: 1.9;
    align-self: start;
  }
</style>