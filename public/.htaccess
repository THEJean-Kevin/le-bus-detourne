RewriteEngine On

# 1. Anciennes URLs Wix : cible absolue (https + www + slash final), en un seul saut
RewriteRule ^notre-brunch/?$ https://www.lebusdetourne.fr/menus/ [R=301,L]
RewriteRule ^privatiser-le-bus/?$ https://www.lebusdetourne.fr/privatisations/ [R=301,L]
RewriteRule ^réceptions-privées/?$ https://www.lebusdetourne.fr/privatisations/ [R=301,L]
RewriteRule ^contact-9/?$ https://www.lebusdetourne.fr/contact/ [R=301,L]

# 2. favicon.ico -> favicon.png
RewriteRule ^favicon\.ico$ https://www.lebusdetourne.fr/favicon.png [R=301,L]

# 3. Dossier sans slash final : on ajoute le slash ET on force https + www dans la même redirection
#    (évite le redirect d'Apache avec ":443" et le double saut)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ https://www.lebusdetourne.fr/$1/ [R=301,L]

# 4. Forcer HTTPS (directement vers la version www)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://www.lebusdetourne.fr/$1 [R=301,L]

# 5. Forcer www
RewriteCond %{HTTP_HOST} ^lebusdetourne\.fr$ [NC]
RewriteRule ^(.*)$ https://www.lebusdetourne.fr/$1 [R=301,L]

# Page 404
ErrorDocument 404 /404.html

# Compression et cache
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  # Fichiers de /_astro/ : le nom change à chaque modification, on peut les garder longtemps
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # Fichiers de public/ dont le nom ne change pas : durée plus courte
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>